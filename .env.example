# Variáveis utilizadas pela aplicação mínima.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CANONICAL_ORIGIN=http://localhost:3000

# Infraestrutura preservada para fases futuras. A aplicação mínima não consome
# estas variáveis, mas seus nomes permanecem documentados sem credenciais reais.
CORS_ALLOWED_ORIGINS=http://localhost:3000
GA_MEASUREMENT_ID=
SESSION_SECRET=substitua-por-uma-chave-segura
ADMIN_USERNAME=
ADMIN_PASSWORD=
ALLOW_DEFAULT_ADMIN_BOOTSTRAP=false
AUTO_IMPORT_GUIDES_ON_START=false
DATABASE_PATH=./database.sqlite
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_SIZE_BYTES=5242880
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
LOGIN_BLOCK_DURATION_MS=900000
SESSION_MAX_AGE_HOURS=8
SESSION_CLEANUP_INTERVAL_MINUTES=30
GUIDE_V2_ENABLED_SLUGS=
RE5_PRODUCT_ANALYTICS_ENABLED=false
RE5_CWV_ENABLED=false
RE5_ERROR_MONITORING_ENABLED=false
RE5_ADS_ENABLED=false
RE5_ADS_TEST_PLACEHOLDERS=false
RE5_ADS_PLACEMENT_SUMMARY_ENABLED=true
RE5_ADS_PLACEMENT_ROADMAP_ENABLED=true
RE5_ADS_PLACEMENT_EXTRAS_ENABLED=true
RE5_ADS_PLACEMENT_DLC_ENABLED=true
